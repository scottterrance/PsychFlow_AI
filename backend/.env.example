# Get a free Groq API key at https://console.groq.com/keys
# (sign up with any email - no Google account, no credit card required)
GROQ_API_KEY=your_key_here

# Optional overrides.
# Default is OpenAI's open 120B model - the strongest free model on Groq.
# Other free Groq models you can try (just change the value below):
#   llama-3.3-70b-versatile      (solid all-rounder, faster)
#   moonshotai/kimi-k2-instruct  (very strong, long context)
#   qwen/qwen3-32b               (strong reasoning)
#   llama-3.1-8b-instant         (fastest, smallest)
GROQ_MODEL=openai/gpt-oss-120b

ALLOWED_ORIGIN=http://localhost:5173
